#remove the doublets
Idents(Ngn3KO.colon) <- "DF.classifications_0.25_0.07_404"
Ngn3KO.colon <- subset(Ngn3KO.colon, ident = "Singlet")

####regress out mitochondria genes and run SCT transformation####
Ngn3KO.colon <- SCTransform(Ngn3KO.colon, vars.to.regress = "percent.mt", verbose = FALSE)

#### visualization and clustering ####
