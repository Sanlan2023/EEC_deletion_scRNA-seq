####visualization of differentially expressed genes####
##Set ceiling for DEG data based on log2FC
Set.ceiling <- function(res.tb,title="",ceiling = 1) {
  #Move the points out of the range to the ceiling.
  table_tb <- res.tb
  idx <- which(table_tb$avg_log2FC > ceiling)
  table_tb[idx,]$avg_log2FC <- ceiling
  table_tb
}
DEGs.all.KOvsWT.fc0.1.FCceiling <- Set.ceiling(DEGs.all.KOvsWT.fc0.1)
