p2 <- DimPlot(Ngn3KO.colon, reduction = "tsne", group.by = "RNA_snn_res.1", split.by = "experiment",cols = my36colors)+ NoLegend()
p1+p2
ggsave("figures/ngn3ko_multiplex/Doublelet.res1.png", width =6, height = 6)
