####load data####
#read data in h5 file format into 10X format
colon1 <- Read10X_h5("Data/ngn3ko_multiplex/raw_data/sample1_feature_bc_matrix.h5", use.names = TRUE, unique.features = TRUE)
colon932 <- Read10X_h5("Data/ngn3ko_multiplex/raw_data/sample932_feature_bc_matrix.h5", use.names = TRUE, unique.features = TRUE)
colon925 <- Read10X_h5("Data/ngn3ko_multiplex/raw_data/sample925_feature_bc_matrix.h5", use.names = TRUE, unique.features = TRUE)
colon3 <- Read10X_h5("Data/ngn3ko_multiplex/raw_data/sample3_feature_bc_matrix.h5", use.names = TRUE, unique.features = TRUE)

#create Seurat object
#use only "Gene Expression" data set but not Multiplex data to create Seurat object
Ngn3KO.1 <- CreateSeuratObject(counts = colon1$`Gene Expression`, project = "Ngn3KO_colon_epi1", min.cells = 3, min.features = 200)
Ngn3KO.2 <- CreateSeuratObject(counts = colon932$`Gene Expression`, project = "Ngn3KO_colon_epi2", min.cells = 3, min.features = 200)
Ngn3WT.1 <- CreateSeuratObject(counts = colon3$`Gene Expression`, project = "WT_colon_epi1", min.cells = 3, min.features = 200)
Ngn3WT.2 <- CreateSeuratObject(counts = colon925$`Gene Expression`, project = "WT_colon_epi2", min.cells = 3, min.features = 200)

#combine the 2 WT data set first
Ctrl.colon <- merge(Ngn3WT.1, y = Ngn3WT.2, project = "Control_colon")

#combine the Control colon with Ngn3 KO colon-1
Ngn3KO.colon <- merge(Ctrl.colon, y = Ngn3KO.1, add.cell.ids = c("Ctrl","Ngn3KO"), project = "Merge_Ngn3KO colon")

Ngn3KO.colon$experiment <- sub("_.*", "", colnames(Ngn3KO.colon))

####data QC####
##Calculate the percentage Mitochondria gene and add to the meta data##
Ngn3KO.colon[["percent.mt"]] <- PercentageFeatureSet(Ngn3KO.colon, pattern = "^mt-")

#Check the nFeature&nCount&percent.mt#
VlnPlot(Ngn3KO.colon, features = c("nFeature_RNA","nCount_RNA", "percent.mt"), ncol = 3)
#save the QC files
ggsave("figures/ngn3ko_multiplex/nFeature_RNA$nCount_RNA&mito_QC.png", width = 10, height = 5)

####post QC filter####
#remove cells with low quality cells
Ngn3KO.colon <- subset(Ngn3KO.colon, subset = nFeature_RNA >200 & nCount_RNA > 1000  & percent.mt <15)
VlnPlot(Ngn3KO.colon, features = c("nFeature_RNA","nCount_RNA","percent.mt"), ncol = 3)
ggsave("figures/ngn3ko_multiplex/Filter.QC_15PercentMito.png", width = 10, height = 5)
FeatureScatter(Ngn3KO.colon, feature1 = "nCount_RNA", feature2 = "nFeature_RNA")
ggsave("figures/ngn3ko_multiplex/FeatureScatterFilter.pdf", width = 5, height = 5)

####remove doublets####
#run tSNE first before finding doublets
#pre-process data using standard workflow for QC
set.seed(1234)
Ngn3KO.colon <- Ngn3KO.colon %>% NormalizeData() %>% FindVariableFeatures() %>% ScaleData() %>% RunPCA()
DimHeatmap(Ngn3KO.colon, dims = 1:30, cells = 500, balanced = TRUE)
ElbowPlot(Ngn3KO.colon, ndims = 50)
dimensions <- 1:15
Ngn3KO.colon <- Ngn3KO.colon %>% RunTSNE(dims = dimensions) %>% FindNeighbors(dims = dimensions) %>% FindClusters(resolution = 1)

##doublets finder
#pK Identification (no ground-truth)
sweep.res.list <- paramSweep(Ngn3KO.colon, PCs = dimensions, sct = F)
sweep.stats <- summarizeSweep(sweep.res.list, GT = FALSE)
bcmvn <- find.pK(sweep.stats)
pK_bcmvn <- bcmvn$pK[which.max(bcmvn$BCmetric)] %>% as.character() %>% as.numeric()

#Homotypic Doublet Proportion Estimate
DoubletRate <- 0.08
homotypic.prop <- modelHomotypic(Ngn3KO.colon$RNA_snn_res.1)
nExp_poi <- round(DoubletRate*ncol(Ngn3KO.colon))
nExp_poi.adj <- round(nExp_poi*(1-homotypic.prop))

#Run DoubletFinder with varying classification stringencies
Ngn3KO.colon <- doubletFinder(Ngn3KO.colon, PCs = dimensions, pN = 0.25, pK = pK_bcmvn, nExp = nExp_poi.adj, reuse.pANN = F, sct = T)

#visuzalization
Ngn3KO.colon@meta.data %>% colnames()
