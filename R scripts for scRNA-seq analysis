p1 <- DimPlot(Ngn3KO.colon, reduction = "umap", label = T, cols = my36colors, group.by = "SCT_snn_res.0.1") + coord_equal() + NoLegend()
p2 <- DimPlot(Ngn3KO.colon, reduction = "umap", label = T, cols = my36colors,group.by = "SCT_snn_res.0.2") + coord_equal() + NoLegend()
p3 <- DimPlot(Ngn3KO.colon, reduction = "umap", label = T, cols = my36colors,group.by = "SCT_snn_res.0.3") + coord_equal() + NoLegend()
p4 <- DimPlot(Ngn3KO.colon, reduction = "umap", label = T, cols = my36colors,group.by = "SCT_snn_res.0.5") + coord_equal() + NoLegend()
p6 <- DimPlot(Ngn3KO.colon, reduction = "umap", label = T, cols = my36colors,group.by = "SCT_snn_res.0.8") + coord_equal() + NoLegend()
p7 <- DimPlot(Ngn3KO.colon, reduction = "umap", label = T, cols = my36colors,group.by = "SCT_snn_res.1") + coord_equal() + NoLegend()
